# Public site URL used for canonical links, the sitemap, and Open Graph URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Digits only, country code included. Example for Pakistan: 923001234567
# Leave blank until you have a real WhatsApp business number. The site will not invent one.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Shown on the contact page. Leave blank rather than publishing a placeholder number.
NEXT_PUBLIC_PHONE_DISPLAY=
NEXT_PUBLIC_CONTACT_EMAIL=

# Supabase. Required for durable quotation storage in production.
# Create the table and private "artwork" bucket from supabase/schema.sql.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional email notification through Resend. All three are required before any email is sent.
RESEND_API_KEY=
QUOTE_FROM_EMAIL=
QUOTE_NOTIFY_EMAIL=
